{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Causewaybay Hacker",
  "version": "../frontend/package.json",
  "identifier": "com.causewaybay.hacker.desktop",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../frontend/dist/": "web/",
      "../content/": "content/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
