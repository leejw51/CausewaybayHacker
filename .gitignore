# Screenshots are regenerable from __cwbCapture (`make -C frontend shots`) and
# churn on every visual change. 6.6 MB of PNGs in the history buys nothing that
# re-running the capture does not.
frontend/shots/
frontend/dist-e2e/

# Intermediate Grok output, 8 MB and fully regenerable from art/prompts.toml.
# The processed PNG/JPG beside it is the deliverable.
art/raw/

# Playwright MCP scratch (console logs, page snapshots) from driving the app.
.playwright-mcp/
.worktrees/
# Scratch screenshots agents drop at the repo root for their own verification.
/*.png

# Claude Code / harness-internal state, not project content.
.claude/

# Scratch captures agents drop at the repo root (base64 dumps, stat logs).
/*.b64
/*.txt

# Python bytecode, from tests/content/verify_pack.py and the art tools.
__pycache__/
*.pyc
.env
