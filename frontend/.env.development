# The dev page is on 5291 and the server on 5390, so the socket has to be told
# where to go. In production the bundle is served by the server itself and the
# URL comes from `location` (SPEC §6).
VITE_WS_URL=ws://127.0.0.1:5390/ws

# Flip to 1 to develop against the in-browser stand-in server instead of the
# real one. Never has any effect in a production build.
VITE_MOCK=0
